{
  "provider": "claude",
  "display_name": "Claude Account",
  "auth_mode": "oauth",
  "models": {
    "sonnet": "claude-sonnet-4-6",
    "haiku": "claude-haiku-4-5",
    "opus": "claude-opus-4-6"
  },
  "default_model": "sonnet",
  "env_vars": {
    "CLAUDE_CODE_PROVIDER": "claude"
  },
  "settings_json": {
    "permissions": {
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./secrets/**)"
      ]
    }
  },
  "prereqs": {
    "host": [
      {
        "id": "internet",
        "label": "Internet connectivity",
        "check": "curl -sf --connect-timeout 5 https://api.anthropic.com",
        "required": true,
        "fail_message": "Cannot reach api.anthropic.com. Check your internet connection."
      }
    ],
    "container": [
      {
        "id": "anthropic-reachable",
        "label": "Anthropic API reachable",
        "check": "curl -sf --connect-timeout 5 https://api.anthropic.com",
        "fail_message": "Cannot reach api.anthropic.com from the container."
      }
    ]
  },
  "docker_requires": [],
  "container_login": "oauth"
}
