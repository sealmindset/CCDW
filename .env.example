# =============================================================================
# Claude Code Docker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# install.bat will create .env from this template automatically on first run.
# =============================================================================

# ---------------------------------------------------------------------------
# Azure AI Foundry (Claude via Azure) -- recommended for Sleep Number
# ---------------------------------------------------------------------------
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_BASE_URL=https://sn-aifoundry-dev.services.ai.azure.com/anthropic

# API key -- get this from your team lead or the AI CoE team
# ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here

# Model deployment names
ANTHROPIC_DEFAULT_SONNET_MODEL=cogdep-aifoundry-dev-eus2-claude-sonnet-4-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=cogdep-aifoundry-dev-eus2-claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=cogdep-aifoundry-dev-eus2-claude-opus-4-6

# ---------------------------------------------------------------------------
# Alternative: Anthropic API Key (personal account)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Alternative: AWS Bedrock
# ---------------------------------------------------------------------------
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Access Ports (defaults shown -- change if conflicts)
# ---------------------------------------------------------------------------
WELCOME_PORT=3000
TTYD_PORT=7681
CODE_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Projects folder on your host machine
# Default is %USERPROFILE%\GitHub (avoids OneDrive Documents redirection)
# Windows example: PROJECTS_PATH=C:\Users\YourName\GitHub
# Mac/Linux example: PROJECTS_PATH=/Users/yourname/Projects
# ---------------------------------------------------------------------------
# PROJECTS_PATH=

# ---------------------------------------------------------------------------
# Docker CLI location (Windows only -- usually not needed)
# Set this if Rancher Desktop or Docker Desktop was installed under a
# different Windows account and install.bat can't find docker.exe.
# Example: DOCKER_PATH=C:\Users\SSMITH\.rd\bin
# ---------------------------------------------------------------------------
# DOCKER_PATH=

# ---------------------------------------------------------------------------
# Workshop port (Business User IDE)
# ---------------------------------------------------------------------------
WORKSHOP_PORT=9200

# ---------------------------------------------------------------------------
# Skills auto-update (set to 0 to disable)
# ---------------------------------------------------------------------------
SKILLS_AUTO_UPDATE=1

# ---------------------------------------------------------------------------
# ACR Pull-Through Cache (corporate networks with SSL inspection)
# If your network blocks Docker Hub (Zscaler, Netskope, etc.), set this
# to the Dockyard Gateway ACR. The installer will pull base images through
# Azure instead of going to the internet directly.
# Requires: az acr login --name dockyardgwprod
# ---------------------------------------------------------------------------
REGISTRY_MIRROR=dockyardgwprod.azurecr.io/docker.io/library/

# ---------------------------------------------------------------------------
# App Development Providers (optional -- for AI features in apps built with /make-it)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_API_VERSION=2024-02-01
