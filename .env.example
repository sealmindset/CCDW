# =============================================================================
# Claude Code Docker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Or skip this and the setup wizard will walk you through it on first run.
# =============================================================================

# ---------------------------------------------------------------------------
# AI Provider (choose ONE)
# ---------------------------------------------------------------------------

# Option 1: Anthropic API Key (personal account)
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Azure AI Foundry (Claude via Azure)
# CLAUDE_CODE_USE_BEDROCK=0
# ANTHROPIC_BASE_URL=https://your-resource.openai.azure.com
# ANTHROPIC_API_KEY=your-azure-api-key

# Option 3: AWS Bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Access Ports (defaults shown -- change if conflicts)
# ---------------------------------------------------------------------------
WELCOME_PORT=3000
TTYD_PORT=7681
CODE_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Code-server authentication (default: none -- no password needed)
# Set to "password" if you want to require a password for VS Code.
# ---------------------------------------------------------------------------
# CODE_SERVER_AUTH=password
# CODE_SERVER_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Projects folder on your host machine (default: ~/Documents/GitHub)
# Most users should leave this as-is. Power users can change it to any
# folder where you want your projects created.
# Windows example: PROJECTS_PATH=C:\Users\YourName\Projects
# Mac/Linux example: PROJECTS_PATH=/Users/yourname/Projects
# ---------------------------------------------------------------------------
# PROJECTS_PATH=~/Documents/GitHub

# ---------------------------------------------------------------------------
# Skills auto-update (set to 0 to disable)
# ---------------------------------------------------------------------------
SKILLS_AUTO_UPDATE=1
