# Ensure batch files always have Windows line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Ensure shell scripts and config always have Unix line endings
# (critical: CRLF breaks scripts inside the Docker container)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
